# Unit systemd для сервиса выреза. Установка — deploy/README.md.
# Решения, из которых он собран: docs/adr/0005-native-onnx-service-over-isolate.md.

[Unit]
Description=cutout_runner - сервис выреза (ONNX-сегментация)
After=network-online.target
Wants=network-online.target
# Сервис не должен уходить в бесконечный цикл перезапусков при системной поломке.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=cutout
Group=cutout
WorkingDirectory=/opt/cutout-runner

# Секрет живёт ТОЛЬКО здесь, с правами 600 и владельцем root:root: файл разбирает сам
# systemd до запуска процесса, поэтому пользователю cutout доступ к нему не нужен.
# В git этот файл не попадает никогда - пример значений в cutout-runner.env.example.
EnvironmentFile=/etc/cutout-runner.env
# Chromium для POST /layout: у пользователя cutout нет домашнего каталога, а ProtectHome
# закрывает /home - браузер лежит в каталоге сервиса (deploy/README.md, раздел 2).
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/cutout-runner/ms-playwright
ExecStart=/usr/bin/node /opt/cutout-runner/dist/main.js

Restart=on-failure
RestartSec=5

# Значения посчитаны под МОДЕЛЬ, а не под машину, и с сентября 2026 перестали быть узким
# местом: после перехода на u2netp запас есть на любой коробке от 2 ГБ.
#
# Замер 2026-09-06 (машина с 31,8 ГиБ, потолка нет вовсе; пик снят как PeakWorkingSet64
# процесса, а не выборкой rss - выборка на JS не видит всплеск внутри блокирующего
# session.run()):
#     u2netp, вход 320                 -> пик 320 МиБ,  инференс 0,55 с (1 поток)
#     birefnet-general-lite, вход 1024 -> пик 6025 МиБ, инференс 18,7-22,3 с (1 поток)
# Способ поверен на второй модели: 6025 МиБ против записанных ранее 6007 и 6013 МиБ.
#
# К пику модели прибавляется разжатый кадр: sharp держит растр целиком, а его потолок в
# приложении - 50 Мп (src/cutout/pipeline.ts), то есть до ~150 МиБ на копию. Отсюда
# MemoryHigh с запасом примерно вдвое над худшим сложением, а MemoryMax - ещё выше и при
# этом заведомо ниже физического ОЗУ любой коробки, на которой сервис имеет смысл ставить.
#
# Правило прежнее: MemoryHigh - выше настоящего пика, MemoryMax - ниже физического ОЗУ.
# Потолок НИЖЕ пика даёт не отказ, а вечную пробуксовку на свопе в состоянии D: cgroup
# вытесняет страницы по достижении MemoryHigh независимо от того, сколько свободно у хоста.
# На этом уже обожглись - разбор в ADR-0015 родительского проекта.
#
# После установки проверить на самой коробке: grep VmHWM /proc/$(pidof -s node)/status
# сразу после нескольких вырезов. Число должно быть заметно ниже MemoryHigh.
#
# Арену ORT не включать: на входе 1024 с ней пик 11,9 ГиБ против 6,0 (замер 2026-09-06).
# Настройка живёт в src/model/session.ts: enableCpuMemArena и enableMemPattern - false.
MemoryHigh=1200M
MemoryMax=1500M

# Изоляция. Приложение не пишет на диск ничего: веса и файл окружения только читаются.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# MemoryDenyWriteExecute намеренно НЕ включён: нативные расширения (ONNX Runtime, libvips)
# отображают исполняемую память, и запрет ломает загрузку сессии.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cutout-runner

[Install]
WantedBy=multi-user.target
