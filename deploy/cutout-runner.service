# Unit systemd для сервиса выреза. Установка — deploy/README.md.
# Решения, из которых он собран: docs/adr/0005-native-onnx-service-over-isolate.md.

[Unit]
Description=cutout_runner - сервис выреза (ONNX-сегментация)
After=network-online.target
Wants=network-online.target
# Сервис не должен уходить в бесконечный цикл перезапусков при системной поломке.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=cutout
Group=cutout
WorkingDirectory=/opt/cutout-runner

# Секрет живёт ТОЛЬКО здесь, с правами 600 и владельцем root:root: файл разбирает сам
# systemd до запуска процесса, поэтому пользователю cutout доступ к нему не нужен.
# В git этот файл не попадает никогда - пример значений в cutout-runner.env.example.
EnvironmentFile=/etc/cutout-runner.env
ExecStart=/usr/bin/node /opt/cutout-runner/dist/main.js

Restart=on-failure
RestartSec=5

# ВНИМАНИЕ: значения зависят от объёма ОЗУ коробки и переносятся между машинами НЕ как есть.
#
# Настоящий пик модели на входе 1024 - 6,0 ГиБ. Замер 2026-09-06 на машине с 31,8 ГиБ,
# где потолка нет вовсе: PeakWorkingSet64 6007 МиБ, повтор 6013 МиБ; после прогона процесс
# оседает на 789 МиБ, то есть это всплеск на запрос, а не постоянная занятость.
#
# Прежнее число 597 МБ, из которого выводились MemoryHigh=1200M, НЕВЕРНО и опровергнуто:
# сэмплер на JS не видит пик внутри блокирующего session.run(), правильный инструмент -
# VmHWM из /proc/self/status (разбор - ADR-0015 родительского проекта). Лимит 1200M
# модель не запускал вовсе, а 3700M на коробке давал пробуксовку на свопе: cgroup вытесняет
# страницы по достижении MemoryHigh независимо от того, сколько свободно у хоста, и один
# запрос перемалывал ~7,7 ГБ обмена при us 2-4% и wa 22-32%.
#
# Значения ниже - под текущую коробку (5920 МБ ОЗУ) и совпадают с тем, что на ней стоит.
# Это КОМПРОМИСС, а не запас: 6,0 ГиБ модели плюс ~0,6 ГБ системы в 5,92 ГБ не помещаются,
# и сервис продолжает притормаживать. На коробке с 8 ГБ и больше ставить 7000M / 7500M.
# Правило: MemoryHigh - выше настоящего пика, MemoryMax - ниже физического ОЗУ, иначе
# защиты нет и вместо мягкого торможения приходит OOM на всю машину.
#
# Арену ORT не включать: с ней пик 11,9 ГиБ против 6,0 (замер 2026-09-06, вход 1024).
# Настройка живёт в src/model/session.ts: enableCpuMemArena и enableMemPattern - false.
MemoryHigh=5000M
MemoryMax=5400M

# Изоляция. Приложение не пишет на диск ничего: веса и файл окружения только читаются.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# MemoryDenyWriteExecute намеренно НЕ включён: нативные расширения (ONNX Runtime, libvips)
# отображают исполняемую память, и запрет ломает загрузку сессии.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cutout-runner

[Install]
WantedBy=multi-user.target
