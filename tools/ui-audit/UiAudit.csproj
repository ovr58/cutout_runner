<Project Sdk="Microsoft.NET.Sdk">

  <!-- Консольный харнесс UI-аудита (референс-реализация системы `auditing-ui`, Phase 3 «краул»):
       запускает целевой WinUI-app в демо-режиме вне процесса, обходит UIA-дерево (FlaUI UIA3),
       кликает контролы и снимает скриншоты. НЕ ссылается на сборку app (управляет им как чёрным
       ящиком через UI Automation) — stack-независим по контракту IUiDriver (web-драйвер
       добавляется отдельной реализацией того же интерфейса). Настройка — блок AuditConfig в
       Program.cs. Подробности — README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>ui-audit</AssemblyName>
    <RootNamespace>UiAudit</RootNamespace>
    <!-- Per-monitor DPI-aware ДО старта: иначе Capture снимает лишь верхний-левый ~40% окна на
         HiDPI (см. app.manifest). ВАЖНО: запускать собранный ui-audit.exe (манифест вшит в apphost),
         а НЕ `dotnet ui-audit.dll` — иначе DPI-режим наследуется от dotnet.exe и обрезка вернётся. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI Automation для Windows-десктопа (UIA3). Тянет FlaUI.Core транзитивно. -->
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>

</Project>
